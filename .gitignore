# Ignore everything by default.
/*

# Then allow ONLY the production library + module definition.
!/.gitignore
!/README.md
!/LICENSE
!/SECURITY.md
!/CHANGELOG.md
!/.github/
!/.github/**
!/go.mod
!/go.sum
!/core/
!/tests/
!/tests/**

# Keep the memory-flood audit and its bounded reproduction harness.
!/docs/
/docs/*
!/docs/MEMORY_FLOOD_AUDIT.md
!/cmd/
/cmd/*
!/cmd/memflood/
/cmd/memflood/*
!/cmd/memflood/main.go

# Within core/, keep build artifacts and local junk out.
core/*.exe
core/*.test
core/*.out
core/*.prof
core/.alos-cert.pem
core/.alos-key.pem

tests/**/*.pem
tests/**/*.key
tests/perfcompare/rust/*/target/
tests/perfcompare/results/
tests/perfcompare/bin/
tests/perfcompare/certs/*
!tests/perfcompare/certs/gen.sh
tests/perfcompare/static/
